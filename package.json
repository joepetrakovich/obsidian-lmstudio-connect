{
	"name": "LM Studio Connect",
	"version": "1.8.4",
	"description": "Adds an AI chat interface that connects to LM Studio so you can chat with your notes privately and offline.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"svelte-check": "svelte-check --tsconfig tsconfig.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"keywords": [
		"obsidian",
		"lmstudio",
		"plugin"
	],
	"author": "Joe Petrakovich",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.30.1",
		"@types/node": "^16.11.6",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"esbuild-svelte": "^0.9.4",
		"eslint": "^9.39.1",
		"eslint-plugin-obsidianmd": "^0.2.5",
		"obsidian": "latest",
		"svelte": "^5.45.10",
		"svelte-check": "^4.3.4",
		"svelte-preprocess": "^6.0.3",
		"tslib": "2.4.0",
		"typescript": "~5.7.0",
		"typescript-eslint": "^8.46.0"
	},
	"dependencies": {
		"@ai-sdk/openai": "^3.0.7",
		"@ai-sdk/openai-compatible": "^2.0.4",
		"@floating-ui/dom": "^1.7.4",
		"ai": "^6.0.23",
		"codemirror": "^6.0.2",
		"i18next": "^25.7.3",
		"zod": "^4.2.1"
	}
}
